{
    "plugins": ["@shufo/prettier-plugin-blade", "prettier-plugin-tailwindcss"],
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4,
    "printWidth": 120,
    "overrides": [
        {
            "files": "*.blade.php",
            "options": {
                "parser": "blade",
                "phpVersion": "8.3",
                "sortTailwindcssClasses": true
            }
        }
    ]
}
