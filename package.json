{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format:frontend": "prettier --write \"resources/**/*.{js,css,blade.php}\" \".github/workflows/*.yml\" \"package.json\" \"README.md\"",
        "format:frontend:check": "prettier --check \"resources/**/*.{js,css,blade.php}\" \".github/workflows/*.yml\" \"package.json\" \"README.md\""
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.16.3",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.17.5",
        "@fontsource-variable/inter": "^5.3.0"
    }
}
